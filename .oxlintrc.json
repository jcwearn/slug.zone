{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Everything here is `error` or `off`, never `warn`. oxlint's default is
  // `correctness` at WARN, and warnings do not affect the exit code -- so
  // without this block `npm run lint` is green no matter what it prints.
  //
  // Not enabled: `pedantic` (its top rules here are no-inline-comments and
  // max-lines-per-function, which fight the house commenting style), plus
  // `perf`, `style`, `restriction` and `nursery`.
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },

  // NOTE: `plugins` REPLACES oxlint's base set rather than adding to it, so
  // this list silently drops `unicorn`, which is on by default. That matches
  // the rest of the fleet; see jackson-wearn/.oxlintrc.json for the count of
  // findings restoring it would add.
  //
  // No `react` plugin here, unlike the other repos: this one has no React.
  "plugins": ["typescript", "oxc"],

  "ignorePatterns": ["dist"]
}
